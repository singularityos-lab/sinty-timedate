[Unit]
Description=Sinty time and date service (timedated-compatible)
Documentation=https://github.com/singularityos-lab/sinty-timedate
After=dbus.service

[Service]
Type=dbus
Environment=DBUS_SYSTEM_BUS_ADDRESS=unix:path=/run/dbus/system_bus_socket
BusName=org.freedesktop.timedate1
ExecStart=/usr/libexec/sinty-timedated
Restart=on-failure
RestartSec=1
